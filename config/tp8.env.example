# Eight-node TP8/EP8 example. This is NOT your live configuration.
# Copy to .env.tp8 and replace every example/SET/replace field.
# Run the upstream orchestration from the head/rank0 host; HEAD_HOST documents that role.
HEAD_HOST=spark-0.example.invalid
HEAD_IP=198.51.100.10
WORKER_IPS="198.51.100.11 198.51.100.12 198.51.100.13 198.51.100.14 198.51.100.15 198.51.100.16 198.51.100.17"
WORKER_HOSTS="spark-1.example.invalid spark-2.example.invalid spark-3.example.invalid spark-4.example.invalid spark-5.example.invalid spark-6.example.invalid spark-7.example.invalid"
# Empty WORKER_USER means use each alias's SSH configuration; never embed credentials.
WORKER_USER=
WORKER_DIR=/replace/with/worker/recipe-checkout
MODEL_DIR=/replace/with/head/DeepSeek-V4.1-Flash-1017
ENGRAM_DIR=/replace/with/head/prepared-engram
WORKER_ENGRAM_DIR=/replace/with/worker/prepared-engram
SSH_IDENTITY=/replace/with/ssh-identity-file
FABRIC_IFACE=SET_RDMA_FABRIC_INTERFACE
NCCL_SOCKET_IFNAME=SET_SOCKET_INTERFACE
GLOO_SOCKET_IFNAME=SET_GLOO_INTERFACE
IB_HCA=SET_RDMA_HCA_LIST
NCCL_IB_GID_INDEX=SET_GID_INDEX

# Measured high-level profile; not a blanket safe default for other hosts.
NNODES=8
TP_SIZE=8
EP_SIZE=8
PORT=8888
DIST_PORT=20000
CONTEXT_LENGTH=1048576
MAX_TOTAL_TOKENS=6600000
MAX_RUNNING_REQUESTS=32
CHUNKED_PREFILL_SIZE=4096
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
SPEC_ALGO=DSPARK
# Upstream DSPARK_BLOCK_SIZE=5 maps to six configured speculative tokens.
DSPARK_BLOCK_SIZE=5
SGLANG_ROCE_ALLREDUCE=1
DSV41_CACHE_GIB=0
# Explicit native flags: boot.py forwards these through EXTRA_SGLANG_ARGS.
EXTRA_SGLANG_ARGS="--kv-cache-dtype fp8_e4m3 --page-size 256 --max-prefill-tokens 32768"
NFS_SHARE=1
OFFLOAD_MODE=nvme
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
HF_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
BUILD_DOCKERFILE=Dockerfile.canary-roce
IMAGE=dsv41-tp8-review:local
# This helper deliberately refuses nonempty inline secret values.
# Do not expose an unauthenticated model endpoint; review upstream auth handling separately.
API_KEY=
